{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carousel-maker",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  // Lista de espera: D1 da própria conta. Exportar: npx wrangler d1 execute carousel-waitlist --remote --command "SELECT * FROM waitlist"
  "d1_databases": [
    { "binding": "WAITLIST_DB", "database_name": "carousel-waitlist", "database_id": "a97d9c56-eb49-48e8-9cc1-c6f93c4cbe3e", "migrations_dir": "migrations" }
  ],
  "vars": { "SITE_ORIGIN": "https://carousel-maker.the-carousel-maker-site.workers.dev" }
  // Secrets (wrangler secret put): SUPABASE_URL, SUPABASE_SECRET_KEY, LEMON_SQUEEZY_API_KEY.
}
