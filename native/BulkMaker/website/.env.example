# Copie para .env. Deixe URL e chave vazias para continuar usando SQLite local.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Origem pública do site, ao hospedar.
# SITE_ORIGIN=https://seu-dominio.com
# HOST=0.0.0.0
# PORT=4173

# Lemon Squeezy: segredo de TESTE, somente no servidor.
LEMON_SQUEEZY_API_KEY=
# Habilitar live somente após aprovação explícita do André.
# LEMON_ALLOW_LIVE=true
# Pasta publish gerada pelo release-mac.sh, com latest.json/appcast.xml/releases.
# RELEASES_DIR=/caminho/para/publish
